# Development Environment Variables
# Скопируйте этот файл в .env и настройте под свои нужды

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mefole_dev_password
POSTGRES_DB=mefole_dev
DATABASE_URL=postgresql+asyncpg://postgres:mefole_dev_password@db:5432/mefole_dev

# Backend Configuration
SECRET_KEY=dev_secret_key_change_in_production
API_V1_STR=/api/v1
PROJECT_NAME=Mefole Group API
PROJECT_VERSION=1.0.0

# URLs and CORS
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Telegram Bot (optional - leave empty if not needed)
TELEGRAM_BOT_TOKEN=

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000